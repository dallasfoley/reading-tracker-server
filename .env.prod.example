AUTH0_DOMAIN=https://your-auth0-domain/

# Neon example:
# jdbc:postgresql://ep-example.us-east-2.aws.neon.tech/reading_tracker?sslmode=require
DATABASE_URL=jdbc:postgresql://your-neon-host/your-db?sslmode=require
DATABASE_USER=your-neon-user
DATABASE_PASSWORD=your-neon-password
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_IDLE=2

# Upstash Redis example:
# rediss://default:your-upstash-password@your-upstash-host:6379
REDIS_URL=rediss://default:your-upstash-password@your-upstash-host:6379
REDIS_USER=default
REDIS_PASSWORD=your-upstash-password

# Use a registry image in real prod, for example:
# APP_IMAGE=ghcr.io/your-user/reading-tracker-server:0.0.1
APP_IMAGE=myapp:prod
